# Copy to .env for Docker Compose. The binary reads exported environment only.
GRAPHITI_TOKEN=replace-with-a-long-random-token
FALKORDB_URL=redis://127.0.0.1:6379
GRAPHITI_GRAPH=graphiti_rs
GRAPHITI_BIND=127.0.0.1:8080
HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MODEL_API_BASE=https://api.openai.com/v1
MODEL_API_KEY=
EXTRACTION_MODEL=gpt-4.1-mini
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
INGEST_JOBS=2
SEARCH_JOBS=2
SEARCH_CANDIDATES=200
REQUEST_TIMEOUT_SECS=30
# Local embeddings:
# CARGO_FEATURES=local-embeddings
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIM=384
# LOCAL_MODEL_DIR=/absolute/path/to/models/minilm
