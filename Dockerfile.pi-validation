FROM rust:1.95-bookworm AS builder
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY tests ./tests
COPY scripts ./scripts
RUN --mount=type=cache,id=graphiti-rs-pi-cargo,target=/usr/local/cargo/registry --mount=type=cache,id=graphiti-rs-pi-target,target=/build/target cargo build --release --locked --all-features && cargo test --release --locked --all-features --no-run && mkdir -p /out && cp target/release/graphiti-rs /out/ && for name in compat compat_differential store mcp models domain search; do find target/release/deps -maxdepth 1 -type f -name "$name-*" -executable -exec cp '{}' /out/ ';'; done && strip /out/*
FROM scratch AS export
COPY --from=builder /out/ /
